// Auth-relevant subset of the full Renovo CRM schema (renovo_crm_schema.sql).
// Run against the SAME database — these models map onto tables already
// created by that migration. `oauth_accounts` is the one new table this
// module introduces; add it via a follow-up migration (see
// prisma/migrations/000_add_oauth_accounts.sql).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id                String    @id @default(uuid())
  name              String
  slug              String    @unique
  status            String    @default("trial")
  stripeCustomerId  String?   @unique @map("stripe_customer_id")
  // The fallback labor rate for any estimate line item with no assigned
  // employee (or an assigned employee with no rate of their own). See
  // migration 010 and estimate-profit.util.ts for the full resolution
  // order this feeds into.
  defaultLaborRate  Decimal   @default(0) @map("default_labor_rate") @db.Decimal(10, 2)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  deletedAt         DateTime? @map("deleted_at")

  companyUsers CompanyUser[]
  roles        Role[]

  @@map("companies")
}

model User {
  id                String    @id @default(uuid())
  email             String    @unique
  phone             String?
  passwordHash      String?   @map("password_hash")
  firstName         String    @map("first_name")
  lastName          String    @map("last_name")
  avatarUrl         String?   @map("avatar_url")
  mfaEnabled        Boolean   @default(false) @map("mfa_enabled")
  mfaSecret         String?   @map("mfa_secret")
  emailVerifiedAt   DateTime? @map("email_verified_at")
  phoneVerifiedAt   DateTime? @map("phone_verified_at")
  lastLoginAt       DateTime? @map("last_login_at")
  status            String    @default("active")
  // Future-ready, unused today: an employee-specific override of the
  // company default labor rate. NULL means "no override — use
  // Company.defaultLaborRate," the correct state for every existing user.
  // See migration 010 and estimate-profit.util.ts for the resolution order.
  hourlyLaborRate   Decimal?  @map("hourly_labor_rate") @db.Decimal(10, 2)
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  companyUsers        CompanyUser[]
  oauthAccounts       OauthAccount[]
  assignedLineItems   EstimateLineItem[]
  acceptedEstimates   Estimate[]
  assignedJobs        Job[]              @relation("JobAssignedUser")
  jobStatusChanges    JobStatusHistory[]

  @@map("users")
}

model Role {
  id            String   @id @default(uuid())
  companyId     String?  @map("company_id")
  name          String
  description   String?
  isSystemRole  Boolean  @default(false) @map("is_system_role")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company         Company?         @relation(fields: [companyId], references: [id])
  rolePermissions RolePermission[]
  companyUsers    CompanyUser[]

  @@unique([companyId, name])
  @@map("roles")
}

model Permission {
  id          String @id @default(uuid())
  key         String @unique
  category    String
  description String

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model CompanyUser {
  id               String    @id @default(uuid())
  companyId        String    @map("company_id")
  userId           String    @map("user_id")
  roleId           String    @map("role_id")
  status           String    @default("invited")
  invitedByUserId  String?   @map("invited_by_user_id")
  invitedAt        DateTime  @default(now()) @map("invited_at")
  joinedAt         DateTime? @map("joined_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  role    Role    @relation(fields: [roleId], references: [id])

  @@unique([companyId, userId])
  @@map("company_users")
}

/// New table for this module — links a user to a Google/Microsoft identity.
/// A user can have multiple OAuth providers linked to the same email-based account.
model OauthAccount {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  provider          String // 'google' | 'microsoft'
  providerAccountId String   @map("provider_account_id")
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("oauth_accounts")
}

// =============================================================================
// CORE CRM DOMAIN — subset of renovo_crm_schema.sql needed by the dashboard
// and the modules that will follow it (jobs, estimates, invoicing).
// =============================================================================

model Crew {
  id        String   @id @default(uuid())
  companyId String   @map("company_id")
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  jobs Job[]

  @@map("crews")
}

model Customer {
  id               String    @id @default(uuid())
  companyId        String    @map("company_id")
  customerType     String    @default("residential") @map("customer_type")
  firstName        String?   @map("first_name")
  lastName         String?   @map("last_name")
  businessName     String?   @map("business_name")
  email            String?
  phone            String?
  secondaryPhone   String?   @map("secondary_phone")
  source           String?
  leadStatus       String    @default("lead") @map("lead_status")
  lifetimeValue    Decimal   @default(0) @map("lifetime_value") @db.Decimal(12, 2)
  // Manual flag, not automated — no Google Business Profile integration
  // exists to detect this. Set only by a direct staff action on the
  // Customer Detail page. NULL means no review confirmed yet; the
  // timestamp is when the owner marked it, not when the review itself
  // was posted (which this app has no way to know).
  reviewReceivedAt DateTime? @map("review_received_at")
  tags             String[]  @default([])
  notesText        String?   @map("notes")
  createdBy        String?   @map("created_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  properties Property[]
  jobs       Job[]
  estimates  Estimate[]
  invoices   Invoice[]
  payments   Payment[]
  notes      CustomerNote[]
  photos     Photo[]
  documents  Document[]
  calls      Call[]

  @@map("customers")
}

model Property {
  id            String    @id @default(uuid())
  companyId     String    @map("company_id")
  customerId    String    @map("customer_id")
  label         String?
  addressLine1  String    @map("address_line1")
  city          String
  state         String
  postalCode    String    @map("postal_code")
  latitude      Decimal?  @db.Decimal(9, 6)
  longitude     Decimal?  @db.Decimal(9, 6)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  deletedAt     DateTime? @map("deleted_at")

  customer  Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  jobs      Job[]
  estimates Estimate[]
  invoices  Invoice[]
  payments  Payment[]
  photos    Photo[]

  @@map("properties")
}

model Estimate {
  id                String    @id @default(uuid())
  companyId         String    @map("company_id")
  customerId        String    @map("customer_id")
  propertyId        String    @map("property_id")
  estimateNumber    String    @map("estimate_number")
  status            String    @default("draft") // 'draft' | 'sent' | 'viewed' | 'accepted' | 'declined' | 'expired'
  source            String?   @map("source") // e.g. 'Website Instant Quote' — null for staff-created estimates
  subtotal          Decimal   @default(0) @map("subtotal") @db.Decimal(12, 2)
  discountType      String?   @map("discount_type") // 'fixed' | 'percentage'
  discountAmount    Decimal   @default(0) @map("discount_amount") @db.Decimal(12, 2)
  // WHY the discount exists, not HOW it's calculated (discountType
  // covers that) — 'package' when auto-applied by Package Discounts,
  // 'manual' when typed in directly, null for anything predating this
  // field or with no discount at all.
  discountSource    String?   @map("discount_source") // 'package' | 'manual'
  taxRate           Decimal   @default(0) @map("tax_rate") @db.Decimal(5, 4) // fraction, e.g. 0.0825 for 8.25%
  taxAmount         Decimal   @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount       Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  validUntil        DateTime? @map("valid_until") @db.Date
  sentAt            DateTime? @map("sent_at")
  viewedAt          DateTime? @map("viewed_at")
  acceptedAt        DateTime? @map("accepted_at")
  declinedAt        DateTime? @map("declined_at")
  declineReason     String?   @map("decline_reason")
  declineComments   String?   @map("decline_comments")
  acceptedVia       String?   @map("accepted_via") // 'portal' | 'staff' | 'manual'
  acceptedByUserId  String?   @map("accepted_by_user_id")
  notes             String?
  terms             String?
  // Staff-only — never rendered on a PDF or exposed through the
  // Customer Portal. Carries over to the Job's own internal_notes
  // (which already existed) on conversion.
  internalNotes     String?   @map("internal_notes")
  signatureDataUrl  String?   @map("signature_data_url")
  createdBy         String?   @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  customer  Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  property  Property            @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  acceptedByUser User?          @relation(fields: [acceptedByUserId], references: [id])
  lineItems EstimateLineItem[]
  invoices  Invoice[]

  @@map("estimates")
}

model EstimateLineItem {
  id                       String   @id @default(uuid())
  companyId                String   @map("company_id")
  estimateId               String   @map("estimate_id")
  serviceType              String   @map("service_type") // see the CHECK constraint in migration 008 for the full set
  description              String
  unitOfMeasure            String   @map("unit_of_measure") // 'sq_ft' | 'linear_ft' | 'each' | 'hours'
  quantity                 Decimal  @db.Decimal(10, 2)
  unitPrice                Decimal  @map("unit_price") @db.Decimal(10, 2)
  // `total` is a Postgres GENERATED column (quantity * unit_price) — never
  // written by the application, always read back after insert/update.
  total                    Decimal  @db.Decimal(12, 2)
  notes                    String?
  sortOrder                Int      @default(0) @map("sort_order")
  // Free-form per-service-type details (roof pitch, driveway surface
  // material, etc.) — shape depends on serviceType, validated at the
  // application layer against a discriminated DTO per service type (see
  // dto/service-details/), not by the database. See migration 010.
  serviceDetails           Json?    @map("service_details")
  estimatedLaborHours      Decimal  @default(0) @map("estimated_labor_hours") @db.Decimal(10, 2)
  estimatedChemicalCost    Decimal  @default(0) @map("estimated_chemical_cost") @db.Decimal(10, 2)
  estimatedEquipmentCost   Decimal  @default(0) @map("estimated_equipment_cost") @db.Decimal(10, 2)
  estimatedFuelCost        Decimal  @default(0) @map("estimated_fuel_cost") @db.Decimal(10, 2)
  estimatedMiscCost        Decimal  @default(0) @map("estimated_misc_cost") @db.Decimal(10, 2)
  // Server-computed, stored — see estimate-profit.util.ts. Nullable
  // because they're only meaningful once cost inputs exist; a freshly
  // created line item with all-zero costs still computes to a real
  // (100%-margin) value, so null specifically means "never computed yet."
  estimatedProfit          Decimal? @map("estimated_profit") @db.Decimal(12, 2)
  profitMarginPercent      Decimal? @map("profit_margin_percent") @db.Decimal(5, 2)
  // Future-ready, unused today: the one piece of schema the
  // employee-rate-override architecture actually needs to ever be
  // invokable. NULL = no employee assigned, falls back to the company
  // default rate. See User.hourlyLaborRate and Company.defaultLaborRate.
  assignedUserId           String?  @map("assigned_user_id")
  // Additive per the approved Service Catalog architecture — set when
  // this line item was created by picking a catalog entry. Nullable:
  // a hand-built line item has no catalog origin, which is completely
  // valid.
  serviceCatalogItemId     String?  @map("service_catalog_item_id")
  createdAt                DateTime @default(now()) @map("created_at")
  updatedAt                DateTime @updatedAt @map("updated_at")

  estimate         Estimate           @relation(fields: [estimateId], references: [id], onDelete: Cascade)
  assignedUser      User?              @relation(fields: [assignedUserId], references: [id])
  serviceCatalogItem ServiceCatalogItem? @relation(fields: [serviceCatalogItemId], references: [id])

  @@map("estimate_line_items")
}

model Job {
  id                    String    @id @default(uuid())
  companyId             String    @map("company_id")
  customerId            String    @map("customer_id")
  propertyId            String    @map("property_id")
  estimateId            String?   @map("estimate_id")
  assignedCrewId        String?   @map("assigned_crew_id")
  // Individual-technician assignment, live today — see migration 013 for
  // the full rationale on why this sits alongside assignedCrewId rather
  // than replacing it.
  assignedUserId        String?   @map("assigned_user_id")
  jobNumber             String    @map("job_number")
  title                 String
  description           String?
  serviceType           String?   @map("service_type")
  status                String    @default("draft") // draft | scheduled | in_progress | paused | completed | cancelled | on_hold
  priority              String    @default("normal")
  scheduledStart        DateTime? @map("scheduled_start")
  scheduledEnd          DateTime? @map("scheduled_end")
  actualStart           DateTime? @map("actual_start")
  actualEnd             DateTime? @map("actual_end")
  // Two distinct numbers, never conflated — see migration 013.
  calculatedLaborHours  Decimal?  @map("calculated_labor_hours") @db.Decimal(10, 2)
  billableLaborHours    Decimal?  @map("billable_labor_hours") @db.Decimal(10, 2)
  price                 Decimal   @default(0) @db.Decimal(12, 2)
  notes                 String?   // customer-facing
  internalNotes         String?   @map("internal_notes") // staff-only, never shown to the customer
  cancellationReason    String?   @map("cancellation_reason")
  createdBy             String?   @map("created_by")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // Phase 2: GPS, tied to actualStart/actualEnd rather than separate
  // checkin/checkout timestamps — see migration 015.
  startLatitude         Decimal?  @map("start_latitude") @db.Decimal(10, 7)
  startLongitude        Decimal?  @map("start_longitude") @db.Decimal(10, 7)
  endLatitude           Decimal?  @map("end_latitude") @db.Decimal(10, 7)
  endLongitude          Decimal?  @map("end_longitude") @db.Decimal(10, 7)

  // Phase 2: Completion
  customerSignatureDataUrl   String?   @map("customer_signature_data_url")
  signatureUnavailableReason String?   @map("signature_unavailable_reason") // customer_not_home | commercial_property | signature_declined
  completionNotes            String?   @map("completion_notes")
  recommendedFutureServices  String[]  @map("recommended_future_services")

  customer      Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  property      Property          @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  crew          Crew?             @relation(fields: [assignedCrewId], references: [id])
  assignedUser  User?             @relation("JobAssignedUser", fields: [assignedUserId], references: [id])
  invoices      Invoice[]
  photos        Photo[]
  documents     Document[]
  lineItems     JobLineItem[]
  statusHistory JobStatusHistory[]
  chemicalUsage JobChemicalUsage[]
  equipmentUsage JobEquipmentUsage[]
  auditLog      JobAuditLog[]

  @@map("jobs")
}

model JobLineItem {
  id             String   @id @default(uuid())
  companyId      String   @map("company_id")
  jobId          String   @map("job_id")
  description    String
  quantity       Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice      Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  // Generated column, same as estimate_line_items — never written by the
  // application, always read back after insert.
  total          Decimal  @db.Decimal(12, 2)
  sortOrder      Int      @default(0) @map("sort_order")
  serviceType    String?  @map("service_type")
  unitOfMeasure  String?  @map("unit_of_measure")
  serviceDetails Json?    @map("service_details")
  notes          String?
  // Copied through from the originating estimate line item when a job
  // is created via createFromEstimate, per the approved architecture.
  serviceCatalogItemId String? @map("service_catalog_item_id")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  serviceCatalogItem ServiceCatalogItem? @relation(fields: [serviceCatalogItemId], references: [id])

  @@map("job_line_items")
}

model ServiceCatalogItem {
  id                        String   @id @default(uuid())
  companyId                 String   @map("company_id")

  name                      String
  serviceType               String   @map("service_type")
  category                  String?
  description                String?
  isActive                  Boolean  @default(true) @map("is_active")

  defaultUnitOfMeasure      String?  @map("default_unit_of_measure")
  defaultUnitPrice          Decimal? @map("default_unit_price") @db.Decimal(12, 2)
  minimumPrice              Decimal? @map("minimum_price") @db.Decimal(12, 2)
  defaultLaborHours         Decimal? @map("default_labor_hours") @db.Decimal(10, 2)
  estimatedDurationMinutes  Int?     @map("estimated_duration_minutes")

  defaultChemicals          Json     @default("[]") @map("default_chemicals")
  defaultEquipment          Json     @default("[]") @map("default_equipment")
  requiredEquipment         Json     @default("[]") @map("required_equipment")

  warrantyDays               Int?     @map("warranty_days")
  warrantyTerms               String?  @map("warranty_terms")
  preparationInstructions    String?  @map("preparation_instructions")
  aftercareInstructions      String?  @map("aftercare_instructions")

  defaultNotes                String?  @map("default_notes")
  defaultTerms                 String?  @map("default_terms")
  // Self-referencing, no DB-level FK on array elements (Postgres
  // limitation) — validated at the application layer. See migration
  // 018's comment.
  suggestedUpsellServiceIds  String[] @map("suggested_upsell_service_ids")
  suggestedFutureServiceIds String[] @map("suggested_future_service_ids")

  sortOrder                 Int      @default(0) @map("sort_order")
  createdAt                 DateTime @default(now()) @map("created_at")
  updatedAt                 DateTime @updatedAt @map("updated_at")

  estimateLineItems EstimateLineItem[]
  jobLineItems      JobLineItem[]
  invoiceLineItems  InvoiceLineItem[]

  @@unique([companyId, name])
  @@map("service_catalog_items")
}

model JobStatusHistory {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  jobId           String   @map("job_id")
  fromStatus      String?  @map("from_status")
  toStatus        String   @map("to_status")
  changedByUserId String?  @map("changed_by_user_id")
  note            String?
  changedAt       DateTime @default(now()) @map("changed_at")
  latitude        Decimal? @db.Decimal(10, 7)
  longitude       Decimal? @db.Decimal(10, 7)

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  changedByUser User? @relation(fields: [changedByUserId], references: [id])

  @@map("job_status_history")
}

model JobChemicalUsage {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  jobId           String   @map("job_id")
  chemicalName    String   @map("chemical_name")
  quantity        Decimal  @db.Decimal(10, 2)
  unit            String   // oz | gallons | liters | ml | lbs | kg
  notes           String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_chemical_usage")
}

model JobEquipmentUsage {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  jobId           String   @map("job_id")
  equipmentName   String   @map("equipment_name")
  notes           String?
  createdByUserId String?  @map("created_by_user_id")
  createdAt       DateTime @default(now()) @map("created_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_equipment_usage")
}

model JobAuditLog {
  id                 String   @id @default(uuid())
  companyId          String   @map("company_id")
  jobId              String   @map("job_id")
  actionType         String   @map("action_type")
  performedByUserId  String?  @map("performed_by_user_id")
  latitude           Decimal? @db.Decimal(10, 7)
  longitude          Decimal? @db.Decimal(10, 7)
  previousValue      Json?    @map("previous_value")
  newValue           Json?    @map("new_value")
  createdAt          DateTime @default(now()) @map("created_at")

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("job_audit_log")
}

model Invoice {
  id                String    @id @default(uuid())
  companyId         String    @map("company_id")
  customerId        String    @map("customer_id")
  propertyId        String?   @map("property_id")
  jobId             String?   @map("job_id")
  estimateId        String?   @map("estimate_id")
  invoiceNumber     String    @map("invoice_number")
  status            String    @default("draft")
  subtotal          Decimal   @default(0) @db.Decimal(12, 2)
  discountType      String?   @map("discount_type")
  discountAmount    Decimal   @default(0) @map("discount_amount") @db.Decimal(12, 2)
  // Snapshotted from the source estimate, same rule as every other
  // financial field on Invoice — never recalculated after creation.
  discountSource    String?   @map("discount_source") // 'package' | 'manual'
  taxRate           Decimal   @default(0) @map("tax_rate") @db.Decimal(5, 4)
  taxAmount         Decimal   @default(0) @map("tax_amount") @db.Decimal(12, 2)
  totalAmount       Decimal   @default(0) @map("total_amount") @db.Decimal(12, 2)
  amountPaid        Decimal   @default(0) @map("amount_paid") @db.Decimal(12, 2)
  // Generated column — never written by the application, always read
  // back after insert/update, same reasoning as every other generated
  // total in this schema.
  balanceDue        Decimal   @map("balance_due") @db.Decimal(12, 2)
  dueDate           DateTime? @map("due_date") @db.Date
  sentAt            DateTime? @map("sent_at")
  viewedAt          DateTime? @map("viewed_at")
  paidAt            DateTime? @map("paid_at")
  notes             String?
  terms             String?
  createdBy         String?   @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  customer Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  property Property?  @relation(fields: [propertyId], references: [id])
  job      Job?       @relation(fields: [jobId], references: [id])
  estimate Estimate?  @relation(fields: [estimateId], references: [id])
  lineItems InvoiceLineItem[]
  payments  Payment[]

  @@map("invoices")
}

model Payment {
  id                  String    @id @default(uuid())
  companyId           String    @map("company_id")
  // Nullable — a payment can exist against a customer directly, with
  // no invoice, for money received before an invoice ever existed
  // (e.g. historical work predating this CRM). customerId below
  // remains required; every payment always has a real customer.
  invoiceId           String?   @map("invoice_id")
  customerId          String    @map("customer_id")
  propertyId          String?   @map("property_id")
  amount              Decimal   @db.Decimal(12, 2)
  method              String
  status              String    @default("pending")
  referenceNumber     String?   @map("reference_number")
  notes               String?
  paymentDate         DateTime? @map("payment_date") @db.Date
  receiptNumber       String?   @map("receipt_number")
  refundedAmount      Decimal   @default(0) @map("refunded_amount") @db.Decimal(12, 2)
  // Optional gratuity, entirely separate from `amount` — never combined
  // with it. `amount` keeps its existing meaning everywhere (invoice
  // balance/status, Customer LTV, dashboard/reports revenue), so those
  // stay correct with zero changes. Same default-0, non-nullable
  // pattern as refundedAmount above, not a new modeling convention.
  tipAmount           Decimal   @default(0) @map("tip_amount") @db.Decimal(12, 2)
  // Credit-card processing fee, a historical dollar snapshot at
  // recording time — never recalculated if the company's configured
  // percentage later changes. cardType records the staff member's
  // explicit selection for a manually-recorded Card payment, since
  // there's no real Stripe metadata available to determine this
  // automatically for that path.
  processingFeeAmount Decimal   @default(0) @map("processing_fee_amount") @db.Decimal(12, 2)
  cardType            String?   @map("card_type")
  stripePaymentIntentId String? @map("stripe_payment_intent_id")
  stripeChargeId      String?   @map("stripe_charge_id")
  processedAt         DateTime? @map("processed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  invoice  Invoice? @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id])

  @@map("payments")
}

model InvoiceLineItem {
  id                    String   @id @default(uuid())
  companyId             String   @map("company_id")
  invoiceId             String   @map("invoice_id")
  description           String
  quantity              Decimal  @default(1) @db.Decimal(10, 2)
  unitPrice             Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  // Generated column, same as estimate_line_items/job_line_items — never
  // written by the application, always read back after insert.
  total                 Decimal  @db.Decimal(12, 2)
  sortOrder             Int      @default(0) @map("sort_order")
  serviceType           String?  @map("service_type")
  unitOfMeasure         String?  @map("unit_of_measure")
  serviceCatalogItemId  String?  @map("service_catalog_item_id")

  invoice            Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  serviceCatalogItem ServiceCatalogItem? @relation(fields: [serviceCatalogItemId], references: [id])

  @@map("invoice_line_items")
}

model Notification {
  id                 String    @id @default(uuid())
  companyId          String    @map("company_id")
  userId             String    @map("user_id")
  notificationType   String    @map("notification_type")
  title              String
  body               String?
  relatedEntityType  String?   @map("related_entity_type")
  relatedEntityId    String?   @map("related_entity_id")
  channel            String    @default("in_app")
  status             String    @default("pending")
  readAt             DateTime? @map("read_at")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@map("notifications")
}

model Photo {
  id                String    @id @default(uuid())
  companyId         String    @map("company_id")
  customerId        String?   @map("customer_id")
  jobId             String?   @map("job_id")
  propertyId        String?   @map("property_id")
  estimateId        String?   @map("estimate_id")
  uploadedByUserId  String?   @map("uploaded_by_user_id")
  photoType         String    @default("other") @map("photo_type")
  s3KeyOriginal     String    @map("s3_key_original")
  s3KeyThumbnail    String?   @map("s3_key_thumbnail")
  s3KeyWeb          String?   @map("s3_key_web")
  fileSizeBytes     BigInt?   @map("file_size_bytes")
  mimeType          String?   @map("mime_type")
  width             Int?
  height            Int?
  isPublicShowcase  Boolean   @default(false) @map("is_public_showcase")
  takenAt           DateTime? @map("taken_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  caption           String?

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job      Job?      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  property Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("photos")
}

model CustomerNote {
  id             String    @id @default(uuid())
  companyId      String    @map("company_id")
  customerId     String    @map("customer_id")
  authorUserId   String?   @map("author_user_id")
  body           String
  isPinned       Boolean   @default(false) @map("is_pinned")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@map("customer_notes")
}

model Document {
  id                  String   @id @default(uuid())
  companyId           String   @map("company_id")
  customerId          String?  @map("customer_id")
  jobId               String?  @map("job_id")
  uploadedByUserId    String?  @map("uploaded_by_user_id")
  fileName            String   @map("file_name")
  documentType        String   @default("other") @map("document_type")
  s3Key               String   @map("s3_key")
  mimeType            String?  @map("mime_type")
  fileSizeBytes       BigInt?  @map("file_size_bytes")
  createdAt           DateTime @default(now()) @map("created_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  job      Job?      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("documents")
}

model CustomFieldDefinition {
  id          String   @id @default(uuid())
  companyId   String   @map("company_id")
  entityType  String   @default("customer") @map("entity_type")
  fieldKey    String   @map("field_key")
  label       String
  fieldType   String   @map("field_type")
  options     Json?
  isRequired  Boolean  @default(false) @map("is_required")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  values CustomFieldValue[]

  @@unique([companyId, entityType, fieldKey])
  @@map("custom_field_definitions")
}

model CustomFieldValue {
  id                 String   @id @default(uuid())
  companyId          String   @map("company_id")
  fieldDefinitionId  String   @map("field_definition_id")
  entityId           String   @map("entity_id")
  value              Json?
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  fieldDefinition CustomFieldDefinition @relation(fields: [fieldDefinitionId], references: [id], onDelete: Cascade)

  @@unique([fieldDefinitionId, entityId])
  @@map("custom_field_values")
}

// =============================================================================
// AI RECEPTIONIST — see ai-receptionist-architecture.md for the full design.
// New tables this module introduces; add via 003_add_receptionist.sql.
// =============================================================================

model Call {
  id                String    @id @default(uuid())
  companyId         String    @map("company_id")
  customerId        String?   @map("customer_id") // null until/unless the caller is identified
  twilioCallSid     String    @unique @map("twilio_call_sid")
  direction         String    @default("inbound") // 'inbound' | 'outbound'
  fromNumber        String    @map("from_number")
  toNumber          String    @map("to_number")
  status            String    @default("in_progress") // 'in_progress' | 'completed' | 'voicemail' | 'transferred' | 'missed'
  outcome           String?   // 'estimate_scheduled' | 'job_rescheduled' | 'faq_answered' | 'transferred' | 'voicemail' | 'no_action'
  transcript        Json?     // array of { role: 'caller'|'assistant', text, at }
  summary           String?
  summaryStructured Json?     // { topics: string[], actionItems: string[], sentiment: string }
  recordingUrl      String?   @map("recording_url")
  recordingSid      String?   @map("recording_sid")
  durationSeconds   Int?      @map("duration_seconds")
  startedAt         DateTime  @default(now()) @map("started_at")
  endedAt           DateTime? @map("ended_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  customer Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@map("calls")
}

model FaqEntry {
  id         String   @id @default(uuid())
  companyId  String   @map("company_id")
  question   String
  answer     String
  isActive   Boolean  @default(true) @map("is_active")
  sortOrder  Int      @default(0) @map("sort_order")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("faq_entries")
}

model ReceptionistSettings {
  id                    String   @id @default(uuid())
  companyId             String   @unique @map("company_id")
  isEnabled             Boolean  @default(false) @map("is_enabled")
  greeting              String   @default("Thanks for calling! How can I help you today?")
  recordingDisclosure   String   @default("This call may be recorded for quality and training purposes.")
  transferPhoneNumber   String?  @map("transfer_phone_number")
  businessHours         Json     // { mon: {open:'08:00', close:'17:00'}, ... , timezone: 'America/New_York' }
  voicemailEnabled      Boolean  @default(true) @map("voicemail_enabled")
  twilioPhoneNumber     String?  @map("twilio_phone_number")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("receptionist_settings")
}

// =============================================================================
// CUSTOMER PORTAL — see customer-portal-architecture.md. Customers authenticate
// via a separate magic-link flow (no password, no shared credential surface
// with staff CRM auth) and can only ever see their OWN records — enforced by
// PortalCustomerGuard filtering on customerId, not just companyId.
// =============================================================================

model ServiceRequest {
  id                    String    @id @default(uuid())
  companyId             String    @map("company_id")
  customerId            String    @map("customer_id")
  propertyId            String?   @map("property_id")
  description           String
  requestedServiceType  String?   @map("requested_service_type")
  isRecurring           Boolean   @default(false) @map("is_recurring")
  recurringFrequency    String?   @map("recurring_frequency")
  preferredDates        String?   @map("preferred_dates")
  status                String    @default("pending") // 'pending' | 'reviewed' | 'converted' | 'declined'
  convertedEstimateId   String?   @map("converted_estimate_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  @@map("service_requests")
}

// =============================================================================
// AUTOMATION — real, server-side, cron-driven (automation/automation.service.ts).
// Sends immediately for enabled rules; AutomationLog is a review-after-the-fact
// record, not an approval queue — see that file for why, given a solo operator.
// =============================================================================

model AutomationSettings {
  id                               String   @id @default(uuid())
  companyId                        String   @unique @map("company_id")
  estimateFollowupEnabled          Boolean  @default(true) @map("estimate_followup_enabled")
  estimateFollowupAfterDays        Int      @default(3) @map("estimate_followup_after_days")
  recurringReminderEnabled         Boolean  @default(true) @map("recurring_reminder_enabled")
  recurringReminderIntervalMonths  Int      @default(12) @map("recurring_reminder_interval_months")
  reviewRequestEnabled             Boolean  @default(true) @map("review_request_enabled")
  reviewRequestDelayDays           Int      @default(1) @map("review_request_delay_days")
  paymentReminderEnabled           Boolean  @default(true) @map("payment_reminder_enabled")
  paymentReminderDaysAfterDue      Int      @default(3) @map("payment_reminder_days_after_due")
  estimateExpirationReminderEnabled     Boolean @default(true) @map("estimate_expiration_reminder_enabled")
  estimateExpirationReminderDaysBefore  Int     @default(2) @map("estimate_expiration_reminder_days_before")
  jobThankYouEnabled                Boolean @default(true) @map("job_thank_you_enabled")
  templates                         Json    @default("{}") @map("templates")
  updatedAt                        DateTime @updatedAt @map("updated_at")

  @@map("automation_settings")
}

model AutomationLog {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  customerId   String?  @map("customer_id")
  ruleType     String   @map("rule_type") // 'estimate_followup' | 'recurring_reminder' | 'review_request'
  dedupeKey    String   @map("dedupe_key")
  channel      String   // 'sms' | 'email'
  messageBody  String   @map("message_body")
  status       String   @default("sent") // 'sent' | 'failed'
  errorDetail  String?  @map("error_detail")
  sentAt       DateTime @default(now()) @map("sent_at")

  @@unique([companyId, dedupeKey])
  @@map("automation_log")
}

// Found already sitting in the base schema, unused by any application
// code, during the Feature 2 (Review Tracking) audit — a real,
// significant correction to that audit's first pass, which concluded
// no review-completion infrastructure existed at all. It does; it was
// just never wired to a Prisma model. Using these tables directly
// rather than adding a redundant Customer column is what "never create
// a second source of truth" means in practice here.
model ReviewRequest {
  id         String    @id @default(uuid())
  companyId  String    @map("company_id")
  customerId String    @map("customer_id")
  jobId      String?   @map("job_id")
  channel    String // 'sms' | 'email'
  status     String    @default("pending") // 'pending' | 'sent' | 'clicked' | 'completed'
  sentAt     DateTime? @map("sent_at")
  clickedAt  DateTime? @map("clicked_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@map("review_requests")
}

model Review {
  id                String    @id @default(uuid())
  companyId         String    @map("company_id")
  customerId        String?   @map("customer_id")
  jobId             String?   @map("job_id")
  platform          String // 'google' | 'yelp' | 'facebook' | 'internal'
  rating            Int?
  reviewText        String?   @map("review_text")
  reviewerName      String?   @map("reviewer_name")
  platformReviewId  String?   @map("platform_review_id")
  aiDraftResponse   String?   @map("ai_draft_response") // not used by this feature — see PROJECT_CONTEXT.md
  responseText      String?   @map("response_text")
  respondedAt       DateTime? @map("responded_at")
  reviewDate        DateTime? @map("review_date")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@map("reviews")
}

