# Database
DATABASE_URL="postgresql://user:password@localhost:5432/renovo_crm"

# Redis (sessions, rate limiting, ephemeral tokens, mail queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — generate with: openssl rand -base64 64
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
JWT_ISSUER=renovo-crm

# Google OAuth (console.cloud.google.com -> Credentials -> OAuth Client ID)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/auth/google/callback

# Microsoft OAuth (Azure Portal -> App registrations)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common
MICROSOFT_CALLBACK_URL=http://localhost:4000/auth/microsoft/callback

# AI Suggestions (optional) — without this, the dashboard's AI Suggestions
# widget uses a deterministic rule engine over the same real stats instead
# of calling Claude. Both paths are fully functional; this just upgrades
# the suggestions from rule-based to LLM-generated narrative text.
ANTHROPIC_API_KEY=

# App
PORT=4000
FRONTEND_URL=http://localhost:3000

# AI Suggestions (dashboard widget) — optional. Without this, the dashboard
# still works: AiSuggestionsService falls back to a deterministic rule
# engine over the same real stats (overdue invoices, stale leads, etc).
ANTHROPIC_API_KEY=

# AI Receptionist — required for the Twilio webhooks and SMS confirmations
# to function. The CRM's settings/FAQ/call-log endpoints work without these
# (a company just can't actually enable the receptionist yet).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# The publicly-reachable base URL Twilio will call back to (ngrok URL in
# dev, your real API domain in production) — also used to derive the
# wss:// ConversationRelay URL for the voice agent.
PUBLIC_API_BASE_URL=https://api.renovocrm.com

# Customer Portal — a completely separate secret from JWT_ACCESS_SECRET
# above (see PortalCustomerGuard for why that separation matters). Generate
# with: openssl rand -base64 64
PORTAL_JWT_SECRET=
PORTAL_JWT_TTL_SECONDS=2592000
PORTAL_URL=https://portal.renovocrm.com
# Real Stripe test-mode keys work for local development; the portal's
# invoice-payment and pay-intent endpoints return "not available" gracefully
# if these aren't set, same pattern as the other optional integrations above.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Email delivery (Postmark: postmarkapp.com -> Servers -> API Tokens).
# Without these, MailProcessor logs "not configured" and skips sending —
# every enqueue() call still succeeds (nothing crashes), it just doesn't
# deliver until real values are set here.
POSTMARK_SERVER_TOKEN=
MAIL_FROM_ADDRESS=

# File storage (AWS S3). IAM setup: create a dedicated IAM user scoped to
# ONLY this bucket (never use root account keys) — see
# docs/ENVIRONMENT_VARIABLES.md for the exact minimal IAM policy. Without
# these, photo upload endpoints will fail when actually called (the
# presigned-URL generation itself doesn't error, but the resulting URL
# won't work).
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=
# Optional — only if you put a CDN in front of the bucket. Photos work
# fine without this, just served directly from S3.
AWS_CLOUDFRONT_URL=

# Logging (pino). One of: fatal, error, warn, info, debug, trace.
# 'info' is the right default — verbose enough to see what's happening,
# quiet enough not to drown out what matters. Turn up to 'debug' only
# while actively diagnosing something, not as a standing production setting.
LOG_LEVEL=info
