# Secrets — never commit these. .env.example is the template; .env holds
# your real values and must never leave your machine/server via git.
.env
.env.local
.env.production
!.env.example

# Dependencies — reinstalled from package-lock.json, never committed
node_modules/

# Build output — regenerated by `npm run build`
backend/dist/
frontend/.next/

# Logs
*.log
npm-debug.log*

# OS/editor noise
.DS_Store
.vscode/
.idea/

# Prisma
backend/prisma/generated/

sprint*-files/
*.patch
integrations-page-files/
